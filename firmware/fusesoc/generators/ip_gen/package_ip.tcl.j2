# Auto-generated by FuseSoC ip_packager — do not edit manually
# Generated for: {{ display_name }}

set ip_name      "{{ module_name }}"
set ip_version   "{{ version }}"
set ip_vendor    "{{ vendor | default('qick') }}"
set ip_library   "{{ library | default('ip') }}"
set ip_dir       [file normalize "{{ ip_dir }}"]
set src_dir      [file normalize "{{ src_dir }}"]

# ── Create in-memory project ─────────────────────────────────
create_project -in_memory -part {{ part | default('xczu49dr-ffvf1760-2-e') }}

# ── Add package sources first (compile order: packages before their
#    importers), then the rest of the RTL ────────────────────
{% for f in pkg_files | default([]) %}
add_files -norecurse ${src_dir}/{{ f }}
{% endfor %}
{% for f in hdl_files %}
add_files -norecurse ${src_dir}/{{ f }}
{% endfor %}

# ── Add include directories (for .svh files) ─────────────────
set_property include_dirs [list ${src_dir}] [current_fileset]

# ── Infer the IP core — output goes to ip_dir (not src_dir) ──
# infer_core works from the directory with its own HDL parser, not from the
# project's top. In a mixed-language IP it can pick a VHDL helper as the top
# (seen with axis_pfba_pr_4x256_v1: "uses SystemVerilog sources with a VHDL
# top file", then "Failed to parse top module entity" in synth_reg_reg.vhd).
# Then retry from the top file alone: the ports and parameters come from it,
# and the synthesis group is rebuilt from src/ below anyway. The simulation
# group gets what the directory inference would have put there: every file
# of src/ but the .xci (HDL and the sub-IPs' .coe).
if {[catch {ipx::infer_core -set_current on ${ip_dir}} infer_err]} {
    set top_file ${src_dir}/${ip_name}.sv
    if {![file exists $top_file]} { error $infer_err }
    puts "  infer_core from the directory failed; retrying from $top_file"
    ipx::infer_core -set_current on -root_dir ${ip_dir} \
        -taxonomy /UserIP -files [list $top_file]
    set sim_fg [ipx::get_file_groups xilinx_anylanguagebehavioralsimulation \
        -of_objects [ipx::current_core]]
    foreach f [lsort [glob -nocomplain -types f -directory ${src_dir} * */*]] {
        if {[file extension $f] eq ".xci" || $f eq $top_file} { continue }
        ipx::add_file $f $sim_fg
    }
}

# ── Set core identity ────────────────────────────────────────
set_property vendor              $ip_vendor   [ipx::current_core]
set_property library             $ip_library  [ipx::current_core]
set_property name                $ip_name     [ipx::current_core]
set_property version             $ip_version  [ipx::current_core]
set_property display_name        "{{ display_name }}" [ipx::current_core]
set_property description         "{{ description }}"  [ipx::current_core]
set_property vendor_display_name "QICK"               [ipx::current_core]
set_property company_url \
    "https://github.com/openquantumhardware/qick"      [ipx::current_core]

# ── Add RTL sources to the IP file group ─────────────────────
# Remove any files inferred from ip_dir itself, add only src/ files
foreach f [ipx::get_files -of_objects \
        [ipx::get_file_groups xilinx_anylanguagesynthesis \
            -of_objects [ipx::current_core]]] {
    ipx::remove_file [get_property name $f] \
        [ipx::get_file_groups xilinx_anylanguagesynthesis \
            -of_objects [ipx::current_core]]
}

# ── SystemVerilog packages & headers, added FIRST ───────────
# Packages are packaged as INCLUDE files, matching the convention the RTL
# now follows repo-wide (and that axis_tprocv1 already used): every package
# carries an `ifndef guard, and every consumer does BOTH
#   `include "qick_pkg.sv"   +   import qick_pkg::*;
#
# Why not ship them as ordinary compiled sources: Vivado's automatic
# compile-order inference gets NO dependency hint from a bare
# `import pkg::*` (unlike a module instantiation), so it happily orders the
# package AFTER its consumer -- measured here as
#   14 frame_deframer.sv / 21 crc8_pkg.sv
# and synthesis then dies with "ERROR: [Synth 8-36] 'crc8_pkg' is not
# declared". That happens in BOTH packaged-IP OOC synthesis and BD Global
# mode, and neither file-group order nor USED_IN fixes it. Pulling the
# package in textually via `include sidesteps ordering entirely.
#
# USED_IN is still set so the file is delivered for synthesis, simulation
# and OOC alike. Plain *.svh headers need only IS_INCLUDE (cf.
# qick_processor's _qproc_defines.svh).
{% for f in pkg_files | default([]) %}
set pkg_file [ipx::add_file ${src_dir}/{{ f }} \
    [ipx::get_file_groups xilinx_anylanguagesynthesis \
        -of_objects [ipx::current_core]]]
set_property is_include true $pkg_file
{% if not f.endswith('.svh') %}
set_property used_in {synthesis simulation out_of_context} $pkg_file
{% endif %}
{% endfor %}
{% for f in hdl_files %}
ipx::add_file ${src_dir}/{{ f }} \
    [ipx::get_file_groups xilinx_anylanguagesynthesis \
        -of_objects [ipx::current_core]]
{% endfor %}

# ── Force SystemVerilog packages to compile first ───────────
# When this IP is expanded into a block design and synthesized out-of-context,
# Vivado does NOT honor plain file order or PROCESSING_ORDER in component.xml —
# it re-derives compile order from dependency analysis. That analysis misses the
# dependency when a module imports a package in its header
# (`module foo import bar_pkg::*; #(...)`), so it compiles the importer before
# the package and errors with 'package is not declared'.
#
# The robust fix is to mark each package (*_pkg.*) with TWO properties:
# 2. PROCESSING_ORDER=EARLY    -> compile early in synthesis
# 3. USED_IN=out_of_context    -> ensure it's present even in standalone OOC builds
#
# Apply to synthesis, simulation, and out-of-context file groups.
foreach grp {xilinx_anylanguagesynthesis xilinx_anylanguagebehavioralsimulation} {
    set fg [ipx::get_file_groups $grp -of_objects [ipx::current_core] -quiet]
    if {$fg eq ""} { continue }
    foreach f [ipx::get_files -of_objects $fg] {
        set fname [file tail [get_property NAME $f]]
        if {[string match "*_pkg.*" $fname]} {
            set_property IS_INCLUDE true $f
            set_property USED_IN {synthesis simulation out_of_context} $f
            puts "  pkg -> EARLY + USED_IN:all ($grp) -> $fname"
        }
    }
}

# ── Auto-infer AXI and clock interfaces ─────────────────────
ipx::infer_bus_interfaces [ipx::current_core]

# ── Custom QICK bus interfaces (.bus_interfaces.yaml) ───────
# QICK's own buses (qick_peripheral, qick_qproc_control, qick_time_control)
# are not inferable; declare them port by port as the legacy cores had them,
# so Top BDs can keep connecting e.g. qick_processor/QPeriphA ->
# qick_time_tagger/qick_peripheral. Any interface infer_bus_interfaces built
# on one of these ports (e.g. xcom's o_time_rst "reset") is removed first.
{% if bus_interfaces %}
set _qick_bus_repo [file normalize ${ip_dir}/../qick_interfaces]
if {[file isdirectory $_qick_bus_repo]} {
    set_property ip_repo_paths $_qick_bus_repo [current_project]
    update_ip_catalog -quiet
}
{% for b in bus_interfaces %}
set _ports [list{% for l, p in b.port_maps %} {{ p }}{% endfor %}]
foreach bif [ipx::get_bus_interfaces -of_objects [ipx::current_core]] {
    foreach pm [ipx::get_port_maps -of_objects $bif] {
        if {[lsearch -exact $_ports [get_property PHYSICAL_NAME $pm]] >= 0} {
            puts "  removing inferred interface [get_property NAME $bif] (port [get_property PHYSICAL_NAME $pm] belongs to {{ b.name }})"
            ipx::remove_bus_interface [get_property NAME $bif] [ipx::current_core]
            break
        }
    }
}
set bif [ipx::add_bus_interface {{ b.name }} [ipx::current_core]]
set_property abstraction_type_vlnv {{ b.abstraction }} $bif
set_property bus_type_vlnv {{ b.vlnv }} $bif
set_property interface_mode {{ b.mode }} $bif
{% for l, p in b.port_maps %}
if {[ipx::get_ports {{ p }} -of_objects [ipx::current_core] -quiet] ne ""} {
    set_property physical_name {{ p }} [ipx::add_port_map {{ l }} $bif]
} else {
    puts {  WARNING: {{ b.name }}.{{ l }}: port '{{ p }}' not found on this core}
}
{% endfor %}
puts {  bus interface -> {{ b.name }} ({{ b.mode }} {{ b.vlnv }})}
{% endfor %}
{% endif %}

# ── Complete partially-inferred AXI-Stream port maps ────────
# infer_bus_interfaces groups ports by a common prefix+suffix, so a port
# whose direction suffix differs from its siblings is dropped from the
# interface: qick_processor's m_dma_axis_o got TDATA/TLAST/TVALID
# (m_dma_axis_t*_o) but not TREADY (m_dma_axis_tready_i), and s_dma_axis_i
# likewise lost s_dma_axis_tready_o. The block designer then tied the
# master's tready to 0 (BD 41-759) and fed the slave's DMA a constant
# tready -- tProc memory readback hangs, program upload can drop words.
# For every AXIS interface, derive each missing signal's port name from the
# TDATA port (tdata -> tready, ..., also trying the flipped _i/_o suffix)
# and add the port map when such an otherwise-unmapped port exists.
set _qick_mapped_ports {}
foreach bif [ipx::get_bus_interfaces -of_objects [ipx::current_core]] {
    foreach pm [ipx::get_port_maps -of_objects $bif] {
        lappend _qick_mapped_ports [get_property PHYSICAL_NAME $pm]
    }
}
foreach bif [ipx::get_bus_interfaces -of_objects [ipx::current_core]] {
    set vlnv [get_property BUS_TYPE_VLNV $bif]
    if {!([string match "*:axis:*" $vlnv] || [string match "*axis_rtl*" $vlnv])} { continue }
    set tdata_pm [ipx::get_port_maps TDATA -of_objects $bif -quiet]
    if {$tdata_pm eq ""} { continue }
    set tdata_port [get_property PHYSICAL_NAME $tdata_pm]
    foreach sig {TREADY TVALID TLAST TKEEP TSTRB TUSER} {
        if {[ipx::get_port_maps $sig -of_objects $bif -quiet] ne ""} { continue }
        set base [string map [list tdata [string tolower $sig]] $tdata_port]
        set cands [list $base]
        if {[string match "*_i" $base]} { lappend cands "[string range $base 0 end-2]_o" }
        if {[string match "*_o" $base]} { lappend cands "[string range $base 0 end-2]_i" }
        foreach cand $cands {
            if {$cand ne $tdata_port && [ipx::get_ports $cand -of_objects [ipx::current_core] -quiet] ne "" \
                    && [lsearch -exact $_qick_mapped_ports $cand] < 0} {
                set pm [ipx::add_port_map $sig $bif]
                set_property PHYSICAL_NAME $cand $pm
                lappend _qick_mapped_ports $cand
                puts "  port map -> [get_property NAME $bif].$sig = $cand"
                break
            }
        }
    }
}

# ── Associate clocks to interfaces (QICK convention) ────────
# Priority:
# 1. Explicit clock_domains from .clock_domains.yaml (if defined)
# 2. Naming convention: s0_axis* -> s0_axis_aclk, m0_axis* -> m0_axis_aclk
# 3. Default: all remaining AXIS -> aclk
set core [ipx::current_core]

# Collect all AXI-Stream interface names present in this core
set all_stream_ifs {}
foreach bif [ipx::get_bus_interfaces -of_objects $core] {
    set vlnv [get_property BUS_TYPE_VLNV $bif]
    if {[string match "*:axis:*" $vlnv] || [string match "*axis_rtl*" $vlnv]} {
        lappend all_stream_ifs [get_property NAME $bif]
    }
}
set remaining_stream_ifs $all_stream_ifs

# True if the core has a clock named $clk, either as an inferred clock
# interface or as a plain port that _qick_set_assoc can promote to one.
proc _qick_has_clk {core clk} {
    expr {[ipx::get_bus_interfaces $clk -of_objects $core -quiet] ne "" || \
          [ipx::get_ports $clk -of_objects $core -quiet] ne ""}
}

proc _qick_set_assoc {core clk busif_list reset} {
    set clkif [ipx::get_bus_interfaces $clk -of_objects $core -quiet]
    # ipx::infer_bus_interfaces only recognizes clock ports by name pattern
    # (*aclk, *_clk, ...); qick_processor's c_clk_i/t_clk_i/ps_clk_i are left
    # as plain ports, so every bus it owns ended up with no associated clock
    # (BD FREQ_HZ mismatches against any correctly-clocked neighbour). A
    # clock named explicitly (.clock_domains.yaml) is promoted here instead.
    if {$clkif eq "" && [ipx::get_ports $clk -of_objects $core -quiet] ne ""} {
        ipx::infer_bus_interface $clk xilinx.com:signal:clock_rtl:1.0 $core
        set clkif [ipx::get_bus_interfaces $clk -of_objects $core -quiet]
    }
    if {$clkif eq ""} { return }
    # ASSOCIATED_BUSIF
    set p [ipx::get_bus_parameters ASSOCIATED_BUSIF -of_objects $clkif -quiet]
    if {$p eq ""} { set p [ipx::add_bus_parameter ASSOCIATED_BUSIF $clkif] }
    set_property value [join $busif_list ":"] $p
    # ASSOCIATED_RESET
    if {$reset ne ""} {
        set r [ipx::get_bus_parameters ASSOCIATED_RESET -of_objects $clkif -quiet]
        if {$r eq ""} { set r [ipx::add_bus_parameter ASSOCIATED_RESET $clkif] }
        set_property value $reset $r
    }
}

# s_axi clock/reset -> s_axi (only if the core has an AXI-Lite). Two
# conventions coexist in this repo: axis_*-style IPs name the ports
# s_axi_aclk/s_axi_aresetn; the XCOM lineage (xcom.sv, xcom_async.sv) names
# them i_ps_clk/i_ps_rstn instead -- infer_core has no way to guess which is
# the AXI clock from the name alone, so try both rather than silently
# leaving the interface unassociated (Vivado accepts an unassociated s_axi
# in a block design, but flags it -- CRITICAL WARNING [BD 41-967] -- and
# some downstream automation/DRC depends on the association being present).
if {[ipx::get_bus_interfaces s_axi -of_objects $core -quiet] ne ""} {
    if {[ipx::get_ports s_axi_aclk -of_objects $core -quiet] ne ""} {
        _qick_set_assoc $core s_axi_aclk {s_axi} s_axi_aresetn
    } elseif {[ipx::get_ports i_ps_clk -of_objects $core -quiet] ne ""} {
        _qick_set_assoc $core i_ps_clk {s_axi} i_ps_rstn
    }
}

# NOTE: this block was implemented in c9993aff and silently removed by
# deec5846 "Update packager files" (2026-08-21), which left the three-step
# comment above describing behaviour that no longer existed. Without it
# ipx::infer_bus_interfaces leaves aclk claiming every interface, so a core
# with a separate envelope or AXI-Lite clock gets FREQ_HZ/CLK_DOMAIN
# mismatches in any block design that clocks those ports independently --
# and "Bus interface is found to be associated with multiple clock-pins".
# remaining_stream_ifs above is only meaningful because of this block; if it
# ever looks unused again, the block has been dropped a second time.

# 1. Apply explicit clock_domains from .clock_domains.yaml (if any)
{% if clock_domains %}
{% for domain in clock_domains %}
_qick_set_assoc $core {{ domain.name }} \
    [list {{ domain.interfaces | join(" ") }}] \
    {{ domain.reset }}
{% for iface in domain.interfaces %}
set idx [lsearch -exact $remaining_stream_ifs {{ iface }}]
if {$idx >= 0} {
    set remaining_stream_ifs [lreplace $remaining_stream_ifs $idx $idx]
}
{% endfor %}
{% endfor %}
{% endif %}

# 2. Apply naming convention to remaining interfaces
set s0_axis_ifs {}
set m0_axis_ifs {}
set other_axis_ifs {}

foreach name $remaining_stream_ifs {
    if {[string match "s0_axis*" $name]} {
        lappend s0_axis_ifs $name
    } elseif {[string match "m0_axis*" $name]} {
        lappend m0_axis_ifs $name
    } else {
        lappend other_axis_ifs $name
    }
}

# 3. Associate each group to its clock domain. s0_axis/m0_axis only get
# their own clock when the core actually has one; otherwise they fall back
# to aclk like every other stream (axis_dyn_readout_v1, axis_readout_v2/v3
# were left with s0_axis/m0_axis unassociated, patched per-BD with
# ASSOCIATED_BUSIF on the cell pin).
if {[llength $s0_axis_ifs] > 0} {
    if {[_qick_has_clk $core s0_axis_aclk]} {
        _qick_set_assoc $core s0_axis_aclk $s0_axis_ifs s0_axis_aresetn
    } else {
        set other_axis_ifs [concat $other_axis_ifs $s0_axis_ifs]
    }
}
if {[llength $m0_axis_ifs] > 0} {
    if {[_qick_has_clk $core m0_axis_aclk]} {
        _qick_set_assoc $core m0_axis_aclk $m0_axis_ifs m0_axis_aresetn
    } else {
        set other_axis_ifs [concat $other_axis_ifs $m0_axis_ifs]
    }
}
if {[llength $other_axis_ifs] > 0} {
    _qick_set_assoc $core aclk $other_axis_ifs aresetn
}

# ── Optional interfaces / ports (.optional_interfaces.yaml) ──────────────
# Mark declared bus interfaces and plain ports ENABLEMENT_DEPENDENCY on HDL
# parameters: the physical port stays in the HDL port list always
# (SystemVerilog can't vary a module's port list with a parameter value),
# but the block designer hides whatever the chosen parameters leave unused,
# as the legacy GUI-packaged QICK IPs do (e.g. qick_processor's m<i>_axis on
# OUT_WPORT_QTY). The dependency is emitted in the spirit:decode(...) form
# Vivado itself writes (ip_packager.py: to_ipxact_dependency). A disabled
# input port is tied to its driver value, forced to 0 here if unset.
{% if optional_interfaces %}
{% for entry in optional_interfaces %}
{% if entry.kind == 'userparam' %}
set up [ipx::add_user_parameter {{ entry.name }} [ipx::current_core]]
set_property value_resolve_type user $up
set_property display_name {{ '{' }}{{ entry.name }}{{ '}' }} $up
set_property value_format {{ entry.format }} $up
set_property value {{ entry.default }} $up
{% if entry.description %}
set_property description {{ '{' }}{{ entry.description }}{{ '}' }} $up
{% endif %}
{% if entry.choices %}
set_property value_validation_type list $up
set_property value_validation_list {{ '{' }}{{ entry.choices | join(' ') }}{{ '}' }} $up
{% endif %}
ipgui::add_param -name {{ entry.name }} -component [ipx::current_core]
puts {  user parameter -> {{ entry.name }} ({{ entry.format }}, default {{ entry.default }})}
{% elif entry.kind == 'tieoff' %}
set opt_obj [ipx::get_ports {{ entry.name }} -of_objects [ipx::current_core] -quiet]
if {$opt_obj ne ""} {
    set_property DRIVER_VALUE {{ entry.value }} $opt_obj
    puts {  tie-off -> {{ entry.name }} = {{ entry.value }}}
} else {
    puts {  WARNING: tie_off_ports '{{ entry.name }}' not found on this core -- entry skipped}
}
{% else %}
{% if entry.kind == 'interface' %}
set opt_obj [ipx::get_bus_interfaces {{ entry.name }} -of_objects [ipx::current_core] -quiet]
{% else %}
set opt_obj [ipx::get_ports {{ entry.name }} -of_objects [ipx::current_core] -quiet]
{% endif %}
if {$opt_obj ne ""} {
    set_property ENABLEMENT_DEPENDENCY {{ '{' }}{{ entry.dependency }}{{ '}' }} $opt_obj
{% if entry.kind == 'port' %}
    if {[get_property DIRECTION $opt_obj] eq "in" && [get_property DRIVER_VALUE $opt_obj] eq ""} {
        set_property DRIVER_VALUE 0 $opt_obj
    }
{% endif %}
    puts {  optional {{ entry.kind }} -> {{ entry.name }} enabled when {{ entry.expr }}}
} else {
    puts {  WARNING: optional {{ entry.kind }} '{{ entry.name }}' not found on this core -- .optional_interfaces.yaml entry skipped}
}
{% endif %}
{% endfor %}
{% endif %}

# ── Add XCI sub-IPs ──────────────────────────────────────────
{% for xci in xci_files | default([]) %}
set xci_file [ipx::add_file ${src_dir}/{{ xci }} \
    [ipx::get_file_groups xilinx_anylanguagesynthesis \
        -of_objects [ipx::current_core]]]
set_property type xci $xci_file
{% endfor %}

# ── Add functional (scoped) XDC constraints ─────────────────
{% for xdc in xdc_files | default([]) %}
set xdc_file [ipx::add_file ${src_dir}/{{ xdc }} \
    [ipx::get_file_groups xilinx_anylanguagesynthesis \
        -of_objects [ipx::current_core]]]
set_property type xdc $xdc_file
set_property used_in {synthesis implementation} $xdc_file
{% if xdc in xdc_late | default([]) %}
# looks its clocks up from the IP ports: must run after the design's clocks exist
set_property processing_order late $xdc_file
{% endif %}
{% endfor %}

# ── Add OOC XDC constraints ─────────────────────────────────
{% for xdc in ooc_xdc_files | default([]) %}
set ooc_file [ipx::add_file ${src_dir}/{{ xdc }} \
    [ipx::get_file_groups xilinx_anylanguagesynthesis \
        -of_objects [ipx::current_core]]]
set_property type xdc $ooc_file
set_property used_in {out_of_context synthesis implementation} $ooc_file
{% endfor %}

# ── Create utility view and add logo ─────────────────────────
{% if has_logo %}
set logo_path [file normalize ${ip_dir}/../../common_ip_files/ip_logos/logoQICK_128x128.png]
if { [file exists $logo_path] } {
    # Create the utility view (ignore if it already exists)
    catch {
        set utility_view [ipx::add_view xilinx_utilityxitfiles [ipx::current_core]]
        set_property display_name "Utility XIT/TTCL" $utility_view
        set_property envIdentifier ":vivado.xilinx.com:xit.util" $utility_view
        set_property language "SystemVerilog" $utility_view
        set_property model_name [get_property name [ipx::current_core]] $utility_view
    }
    
    # Create the file group (ignore if it already exists)
    catch {
        set logo_fg [ipx::add_file_group xilinx_utilityxitfiles [ipx::current_core]]
    }
    
    # Add file set reference (ignore if it already exists)
    catch {
        set utility_view [ipx::get_views -of_objects [ipx::current_core] xilinx_utilityxitfiles]
        ipx::add_file_set_ref xilinx_utilityxitfiles $utility_view
    }
    
    # Add the logo file (ignore if it already exists)
    catch {
        set logo_fg [ipx::get_file_groups xilinx_utilityxitfiles -of_objects [ipx::current_core]]
        ipx::add_file $logo_path $logo_fg
        set_property user_file_type LOGO [ipx::get_files $logo_path -of_objects $logo_fg]
    }
    puts "  Logo added: ../../common_ip_files/ip_logos/logoQICK_128x128.png"
} else {
    puts "  WARNING: Logo file not found at $logo_path"
}
{% endif %}

# ── Save component.xml to ip_dir ─────────────────────────────
# core_revision -> COREREVISION in the HWH: the PATCH of the .core's
# MAJOR.MINOR.PATCH (ip_packager.py: get_core_revision), e.g.
# qick:ip:qick_processor:1.0.27 -> VLNV version 1.0, revision 27.
set_property core_revision {{ core_revision | default(1) }} [ipx::current_core]
ipx::create_xgui_files       [ipx::current_core]
ipx::update_checksums        [ipx::current_core]
ipx::save_core               [ipx::current_core]

puts ""
puts "✓ IP packaged successfully"
puts "  component.xml : ${ip_dir}/component.xml"
puts "  xgui          : ${ip_dir}/xgui/"
puts ""
