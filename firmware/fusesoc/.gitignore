build/
*.egg-info/
__pycache__/
*.vcd
.fusesoc_libraries/
fusesoc.conf
qick_fused.egg-info/

# Generated by PeakRDL - DO NOT COMMIT
*_regmap_pkg/
*_regmap.sv
*_regmap_pkg.sv
*_regmap.svh
*.pyc
__pycache__/
.pytest_cache/

# Code coverage artifacts (make coverage / coverage-all).
# The per-tool logs (cov_setup.log, xcrg.log, verilator_coverage.log) are
# already covered by the root .gitignore "**.log" rule.
# COV_OUT=report_cov_<name> keeps several runs side by side (e.g. one per Verilator version).
report_cov*/
*.ucdb

# SVUnit's generator (svunit_gen) writes its file list into the core: cores/<...>/generated/.svunit.f.
cores/**/generated/

# PeakRDL HTML docs: `make rdl-docs IP=<ip>` writes a whole static site (content/, css/, js/, fonts/, search/, launchers) INTO cores/ip/<ip>/rdl/.
# Generated, never committed (88 of these files went into a commit once by `git add` on a directory, 2026-10-07).
cores/ip/*/rdl/content/
cores/ip/*/rdl/css/
cores/ip/*/rdl/data/
cores/ip/*/rdl/fonts/
cores/ip/*/rdl/js/
cores/ip/*/rdl/search/
cores/ip/*/rdl/.launcher_data/
cores/ip/*/rdl/index.html
cores/ip/*/rdl/favicon.png
cores/ip/*/rdl/launcher-windows-*.bat

# pytest / fusesoc leftovers (report_pytest/ is written by `make driver-test`, report_svunit/ by `make sim_svunit`; .fusesoc_libraries is a FILE, the "/" rule above misses it)
report_pytest/
report_svunit/
.fusesoc_libraries
