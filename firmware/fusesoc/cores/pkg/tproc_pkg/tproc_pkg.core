CAPI=2:
name: qick:pkg:tproc_pkg:0.1.0
description: QICK timed processors (tProc) package 

filesets:
  hdl:
    files:
      - hdl/tproc_pkg.sv: {is_include_file: true}
    file_type: systemVerilogSource

  lint_files:
    depend:
      - qick:common:lint


targets:
  default: &default
    filesets:
      - hdl
      - lint_files

  lint:
    <<: *default
    default_tool: veriblelint
    toplevel: [tproc_pkg]
    tools:
      verilator:
        mode: lint-only
        verilator_options: [-Wall]

