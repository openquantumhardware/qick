CAPI=2:
name: qick:pkg:tpv2_pkg:0.1.0
description: QICK tProcessor v2 (tprocv2) package

filesets:
  hdl:
    files:
      - hdl/tpv2_pkg.sv: {is_include_file: true}
    file_type: systemVerilogSource

  lint_files:
    depend:
      - qick:common:lint


targets:
  default: &default
    filesets:
      - hdl
      - lint_files

  lint:
    <<: *default
    default_tool: veriblelint
    toplevel: [tpv2_pkg]
    tools:
      verilator:
        mode: lint-only
        verilator_options: [-Wall]
