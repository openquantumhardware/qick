CAPI=2:
name: qick:ip:axis_readout_v3:1.0.1
description: "QICK tProc-controlled readout v3 (axis_readout_v3) IP core"

filesets:
  hdl:
    files:
      - hdl/axis_readout_v3.sv
    file_type: systemVerilogSource
    depend:
      - qick:dsp:readout_top_ro_v3

  constraints:
    files:
      - constraints/axis_readout_v3.xdc: {file_type: xdc}
    file_type: xdc

  constraints_ooc:
    files:
      - constraints/axis_readout_v3_ooc.xdc: {file_type: xdc}
    file_type: xdc

  tb:
    files:
      - tests/axis_readout_v3_tc00.sv
      - tests/axis_readout_v3_tests.sv: {is_include_file: true}
    file_type: systemVerilogSource
    depend:
      - qick:common:xilinx
      - qick:common:sim_base
      - qick:interfaces:axi4_stream_if

  lint_files:
    depend:
      - qick:common:lint

targets:
  default: &default
    filesets: [hdl]
    toplevel: axis_readout_v3

  lint:
    filesets: [hdl, lint_files]
    toplevel: axis_readout_v3
    default_tool: veriblelint
    tools:
      verilator:
        mode: lint-only
        verilator_options: [-Wall]

  test:
    description: Simulate the design
    filesets: [hdl, tb]
    default_tool: xsim
    generate: [testrunner_gen]
    toplevel: testrunner
    tools:
      xsim:
        xelab_options: [-debug all -L XPM -top work.glbl -timescale=1ns/1ps]
        xsim_options: [-testplusarg SVUNIT_FILTER="*" -onerror stop]

  synth:
    <<: *default
    description: OOC Synthesis with Vivado (validate RTL + packages)
    default_tool: vivado
    tools:
      vivado:
        part: xczu49dr-ffvf1760-2-e
        pnr: none

generate:
  testrunner_gen:
    generator: svunit_gen
    parameters:
        test_files:
          - tests/axis_readout_v3_tc00.sv
