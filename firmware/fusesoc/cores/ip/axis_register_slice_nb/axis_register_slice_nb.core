CAPI=2:
name: qick:ip:axis_register_slice_nb:1.0.1
description: "QICK N-stage AXI4-Stream register pipeline without backpressure (axis_register_slice_nb) IP core"

filesets:
  hdl:
    files:
      - hdl/axis_register_slice_nb.sv
    file_type: systemVerilogSource

  tb:
    files:
      - tests/axis_register_slice_nb_tc00.sv
      - tests/axis_register_slice_nb_tests.sv: {is_include_file: true}
    file_type: systemVerilogSource
    depend:
      - qick:common:sim_base

  lint_files:
    depend:
      - qick:common:lint

targets:
  default: &default
    filesets: [hdl]
    toplevel: axis_register_slice_nb

  lint:
    filesets: [hdl, lint_files]
    toplevel: axis_register_slice_nb
    default_tool: veriblelint
    tools:
      verilator:
        mode: lint-only
        verilator_options: [-Wall]

  test:
    description: Simulate the design
    filesets: [hdl, tb]
    default_tool: xsim
    generate: [testrunner_gen]
    toplevel: testrunner
    tools:
      xsim:
        xelab_options: [-debug all -timescale=1ns/1ps]
        xsim_options: [-testplusarg SVUNIT_FILTER="*" -onerror stop]

  synth:
    <<: *default
    description: OOC Synthesis with Vivado (validate RTL)
    default_tool: vivado
    tools:
      vivado:
        part: xczu49dr-ffvf1760-2-e
        pnr: none

generate:
  testrunner_gen:
    generator: svunit_gen
    parameters:
        test_files:
          - tests/axis_register_slice_nb_tc00.sv
