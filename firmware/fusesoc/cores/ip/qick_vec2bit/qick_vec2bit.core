CAPI=2:
name: qick:ip:qick_vec2bit:1.0.0
description: "QICK vector to single-bit outputs (qick_vec2bit) IP core"

filesets:
  hdl:
    files:
      - hdl/qick_vec2bit.sv
    file_type: systemVerilogSource

  tb:
    files:
      - tests/ref/qick_vec2bit_legacy.v: {file_type: verilogSource}
      - tests/qick_vec2bit_tc00.sv
      - tests/qick_vec2bit_tests.sv: {is_include_file: true}
    file_type: systemVerilogSource
    depend:
      - qick:common:sim_base

  lint_files:
    depend:
      - qick:common:lint

targets:
  default: &default
    filesets: [hdl]
    toplevel: qick_vec2bit

  lint:
    filesets: [hdl, lint_files]
    toplevel: qick_vec2bit
    default_tool: veriblelint
    tools:
      verilator:
        mode: lint-only
        verilator_options: [-Wall]

  test:
    description: Simulate the design (against the legacy RTL as the golden model)
    filesets: [hdl, tb]
    default_tool: xsim
    generate: [testrunner_gen]
    toplevel: testrunner
    tools:
      xsim:
        xelab_options: [-debug all -timescale=1ns/1ps]
        xsim_options: [-testplusarg SVUNIT_FILTER="*" -onerror stop]

  synth:
    <<: *default
    description: OOC Synthesis with Vivado (validate RTL)
    default_tool: vivado
    tools:
      vivado:
        part: xczu49dr-ffvf1760-2-e
        pnr: none

generate:
  testrunner_gen:
    generator: svunit_gen
    parameters:
        test_files:
          - tests/qick_vec2bit_tc00.sv
