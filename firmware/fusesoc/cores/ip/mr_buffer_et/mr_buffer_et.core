CAPI=2:
name: qick:ip:mr_buffer_et:1.2.0
description: Multi-Rate (MR) Buffer with external trigger.

filesets:
  hdl:
    files:
      - hdl/mr_buffer_et.sv
    file_type: systemVerilogSource
    depend:
      - qick:axi:axil_slv
      - qick:cdc:cdc_bit_sync
      - qick:mem:mr_buffer

  constraints:
    files:
      - constraints/mr_buffer_et.xdc: {file_type: xdc}
    file_type: xdc

  constraints_ooc:
    files:
      - constraints/mr_buffer_et_ooc.xdc: {file_type: xdc}
    file_type: xdc

  tb:
    files:
      - tests/mr_buffer_et_tc00.sv
      - tests/mr_buffer_et_tests.sv: {is_include_file: true}
    file_type: systemVerilogSource
    depend:
      - qick:interfaces:axi4_lite_if
      - qick:common:sim_base

  lint_files:
    depend:
      - qick:common:lint

generate:
  testrunner_gen:
    generator: svunit_gen
    parameters:
      test_files:
        - tests/mr_buffer_et_tc00.sv

targets:
  default: &default
    filesets: [hdl]
    toplevel: mr_buffer_et

  lint:
    <<: *default
    filesets_append: [lint_files]
    default_tool: veriblelint
    toplevel: mr_buffer_et
    tools:
      verilator:
        mode: lint-only
        verilator_options: [-Wall]

  test: &test
    description: Simulate the design
    filesets: [hdl,tb]
    default_tool: xsim
    generate: [testrunner_gen]
    toplevel: testrunner
    parameters: [MRBUF_NM, MRBUF_N]
    tools:
      xsim:
        xelab_options: [-timescale=1ns/1ns -debug all -L XPM -d SVUNIT]
        xsim_options: [-testplusarg SVUNIT_FILTER="*" -onerror stop]
      modelsim:
        vlog_options: [-timescale=1ns/1ns -L xpm]              # XPM library
      icarus:
        iverilog_options:
          - -g2012 # Use SystemVerilog-2012

  test_deployed:
    <<: *test
    parameters:
      - MRBUF_NM=2
      - MRBUF_N=16

  synth:
    <<: *default
    description: Synthesize the design
    filesets_append: [constraints_ooc]
    default_tool: vivado
    tools:
      vivado:
        part: xczu48dr-fsvg1517-2-e
    parameters:
      - N
      - B

  package:
    description: Package IP for Vivado IP Catalog
    filesets: [hdl, constraints]
    toplevel: mr_buffer_et
    generate: [mr_buffer_et_packager_gen]

parameters:
  MRBUF_NM:
    datatype: int
    paramtype: vlogdefine
    default: 8
  MRBUF_N:
    datatype: int
    paramtype: vlogdefine
    default: 8

# Usage
# fusesoc run --target=sim_deployed qick:ip:mr_buffer_et
# with combinations --MRBUF_NM=4 --MRBUF_N=12
#
# fusesoc run --target=test_deployed qick:ip:mr_buffer_et --MRBUF_NM=4 --MRBUF_N=12
