CAPI=2:
name: qick:ip:qick_periph_loopback:1.0.0
description: "qick_periph_loopback: test peripheral for the QP1/QP2 ports of the tProc v2 (qick_peripheral slave)"

filesets:
  hdl:
    files:
      - hdl/qick_periph_loopback.sv
    file_type: systemVerilogSource
    # depend:
    #   - qick:pkg:<your_pkg>   # add package deps here if needed
  tb:
    files:
      - tests/qick_periph_loopback_tc00.sv
      - tests/qick_periph_loopback_tests.sv: {is_include_file: true}
    file_type: systemVerilogSource
    depend:
      - qick:common:sim_base
  lint_files:
    depend:
      - qick:common:lint

generate:
  testrunner_gen:
    generator: svunit_gen
    parameters:
        test_files:
          - tests/qick_periph_loopback_tc00.sv

targets:
  default: &default
    filesets: [hdl]
    toplevel: qick_periph_loopback
  lint:
    <<: *default
    filesets_append: [lint_files]
    default_tool: veriblelint
    toplevel: qick_periph_loopback
    tools:
      verilator:
        mode: lint-only
        verilator_options: [-Wall]
  test:
    <<: *default
    description: Simulate the design
    filesets_append: [tb]
    default_tool: xsim
    generate: [testrunner_gen]
    toplevel: testrunner
    tools:
      xsim:
        xelab_options: [-timescale=1ns/1ns -debug all -L XPM]
        xsim_options: [-testplusarg SVUNIT_FILTER="*" -onerror stop]
