CAPI=2:
name: qick:ip:axis_streamer:2.0.1
description: "AXI4-Strem buffer with one-shot/continuous modes"

filesets:
  hdl:
    files:
      - hdl/axis_streamer.sv
    file_type: systemVerilogSource
    depend:
      - qick:ctrl:streamer
      - qick:axi:axil_slv

  constraints:
    files:
      - constraints/axis_streamer.xdc: {file_type: xdc}
    file_type: xdc

  constraints_ooc:
    files:
      - constraints/axis_streamer_ooc.xdc: {file_type: xdc}
    file_type: xdc

  tb:
    files:
      - tests/axis_streamer_tc00.sv
      - tests/axis_streamer_tests.sv: {is_include_file: true}
    file_type: systemVerilogSource
    depend:
      - qick:common:xilinx
      - qick:common:sim_base
      - qick:interfaces:axi4_lite_if
      - qick:interfaces:axi4_stream_if
      
  lint_files:
    depend:
      - qick:common:lint

generate:
  testrunner_gen:
    generator: svunit_gen
    parameters:
        test_files:
          - tests/axis_streamer_tc00.sv

targets:
  default:
    filesets: [hdl]
    toplevel: axis_streamer
  lint:
    filesets: [hdl, lint_files]
    default_tool: veriblelint
    toplevel: axis_streamer
    tools:
      verilator:
        mode: lint-only
        verilator_options: [-Wall]

  test:
    filesets: [hdl, tb]
    default_tool: xsim
    generate: [testrunner_gen]
    toplevel: testrunner
    parameters: [ASYNC_CLK, TB_N_FIFO, TB_MEM]
    tools:
      xsim:
        # NOTE: precision must be finer than 1ns. With 1ns/1ns a 307.2 MHz
        # clk_gen half-period (1.6276 ns) silently rounds to 2 ns.
        xelab_options: [-debug all -L XPM -top work.glbl -timescale=1ns/1ps -d SVUNIT]
        xsim_options: [-testplusarg SVUNIT_FILTER="*" -onerror stop]
  synth:
    filesets: [hdl]
    description: Synthesize the design
    default_tool: vivado
    toplevel: axis_streamer
    tools:
      vivado:
        part: xczu49dr-ffvf1760-2-e
        synth_options:
          - -include_dirs $XILINX_VIVADO/data/ip/xpm

parameters:
  ASYNC_CLK:
    datatype   : int
    description: "0 = single clock, 1 = s_clk 307.2 MHz / m_clk 100 MHz"
    paramtype  : vlogdefine
    default    : 0
  TB_N_FIFO:
    datatype    : int
    description : Internal FIFO depth used by the testbench
    paramtype   : vlogdefine
    default     : 16
  TB_MEM:
    datatype    : int
    description : "FIFO storage: 0=auto, 1=distributed, 2=block, 3=ultra"
    paramtype   : vlogdefine
    default     : 0
  B_TDATA:
    datatype: int
    description: Width of TDATA in bits
    paramtype: vlogparam
  B_TUSER:
    datatype: int
    description: Width of TUSER in bits
    paramtype: vlogparam
  B_AXIS:
    datatype: int
    description: Width of AXI stream output in bits
    paramtype: vlogparam
  N_FIFO:
    datatype: int
    description: FIFO depth (power of 2)
    paramtype: vlogparam

# ----- Usage ----------------------------------------------------------------
#   make sim IP=streamer                              # 16 deep, distributed
#   make sim IP=streamer FIFO=1024 MEM=block          # BRAM path
#   make sim IP=streamer ASYNC=1 FIFO=1024 MEM=block  # BRAM across the CDC
#   make sim IP=axis_streamer FIFO=1024 MEM=block
#
# Check the [CFG] line and the test-case name: both carry the depth and the
# storage type, so a define that never reached xvlog is visible immediately.

