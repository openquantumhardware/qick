CAPI=2:
name: qick:ip:axis_streamer_regmap:0.1.0
description: "SystemRDL register map for qick:ip:axis_streamer"

filesets:
  rdl:
    files:
      - axis_streamer_regmap.rdl: {file_type: user}

  # Generated by `make gen IP=axis_streamer` (PeakRDL). These files do not
  # exist in a fresh checkout, so they live in their own fileset: a core that
  # only needs the driver/Python package must not fail to load because the
  # SystemVerilog export has not been run yet.
  generated_hdl:
    files:
      - axis_streamer_regmap_pkg.sv: {file_type: systemVerilogSource, is_include_file: true}
      - axis_streamer_regmap.sv:     {file_type: systemVerilogSource, is_include_file: true}

targets:
  # A CAPI=2 core with no targets exports nothing to its dependents. Keep this
  # default target, or `depend: [qick:ip:axis_streamer_regmap]` silently pulls
  # in no files at all.
  default:
    filesets: [rdl]
