CAPI=2:
name: qick:ip:axis_tprocv1:1.0.1
description: "QICK AXI4-Stream Timed Processor v1 (axis_tprocv1) IP core"

filesets:
  hdl:
    files:
      - hdl/axis_tprocv1.sv
    file_type: systemVerilogSource
    depend:
      - qick:ip:axis_tprocv1_regmap
      - qick:axi:axi_slv_tprocv1
      - qick:interfaces:axi4_stream_if
      - qick:mem:dmem
      - qick:mem:bram_tdp
      - qick:processors:tprocv1

  constraints:
    files:
      - constraints/axis_tprocv1.xdc: {file_type: xdc}
    file_type: xdc

  constraints_ooc:
    files:
      - constraints/axis_tprocv1_ooc.xdc: {file_type: xdc}
    file_type: xdc

  tb:
    files:
      - tests/axis_tprocv1_tc00.sv
      - tests/axis_tprocv1_tests.sv: {is_include_file: true}
    file_type: systemVerilogSource
    depend:
      - qick:common:sim_base
      - qick:interfaces:axi4_lite_if

  lint_files:
    depend:
      - qick:common:lint

generate:
  testrunner_gen:
    generator: svunit_gen
    parameters:
        test_files:
          - tests/axis_tprocv1_tc00.sv

targets:
  default: &default
    filesets: [hdl]
    toplevel: axis_tprocv1

  lint:
    filesets: [hdl, lint_files]
    toplevel: axis_tprocv1
    default_tool: veriblelint
    tools:
      verilator:
        mode: lint-only
        verilator_options: [-Wall]

  test:
    description: Simulate the design
    filesets: [hdl, tb]
    default_tool: xsim
    generate: [testrunner_gen]
    toplevel: testrunner
    tools:
      xsim:
        xelab_options: [-timescale=1ns/1ns -debug all -L XPM -d SVUNIT]
        xsim_options: [-testplusarg SVUNIT_FILTER="*" -onerror stop]
      icarus:
        iverilog_options:
          - -g2012
      modelsim:
        vlog_options:
          - -timescale=1ns/1ns

  synth:
    <<: *default
    description: OOC Synthesis with Vivado (validate RTL + packages)
    default_tool: vivado
    tools:
      vivado:
        part: xczu49dr-ffvf1760-2-e
        pnr: none
