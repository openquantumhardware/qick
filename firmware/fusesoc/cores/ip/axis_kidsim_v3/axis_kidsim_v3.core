CAPI=2:
name: qick:ip:axis_kidsim_v3:1.0.0
description: "KID simulator IP: L parallel kidsim_top lanes + AXI4-Lite register block."
filesets:
  hdl:
    files:
      - hdl/axis_kidsim_v3.sv
    file_type: systemVerilogSource
    depend:
      - qick:ctrl:kidsim_top
      - qick:axi:axil_slv

  constraints:
    files:
      - constraints/axis_kidsim_v3.xdc: {file_type: xdc}
    file_type: xdc

  constraints_ooc:
    files:
      - constraints/axis_kidsim_v3_ooc.xdc: {file_type: xdc}
    file_type: xdc

  tb:
    files:
      - tests/axis_kidsim_v3_tc00.sv
      - tests/axis_kidsim_v3_tests.sv: {is_include_file: true}
    file_type: systemVerilogSource
    depend:
      - qick:common:sim_base
      - qick:interfaces:axi4_lite_if
      - qick:interfaces:axi4_stream_if
  lint_files:
    depend:
      - qick:common:lint
generate:
  testrunner_gen:
    generator: svunit_gen
    parameters:
        test_files:
          - tests/axis_kidsim_v3_tc00.sv
targets:
  default: &default
    filesets: [hdl]
    toplevel: axis_kidsim_v3
  lint:
    <<: *default
    filesets_append: [lint_files]
    default_tool: veriblelint
    toplevel: axis_kidsim_v3
    tools:
      verilator:
        mode: lint-only
        verilator_options: [-Wall]
  test:
    <<: *default
    description: Simulate the design
    filesets_append: [tb]
    default_tool: xsim
    generate: [testrunner_gen]
    toplevel: testrunner
    tools:
      xsim:
        xelab_options: [-timescale=1ns/1ns -debug all -L XPM -d SVUNIT]
        xsim_options: [-testplusarg SVUNIT_FILTER="*" -onerror stop]
