CAPI=2:
name: qick:processors:qtt_cmd:1.0.0
description: qtt_cmd (processors library core).

filesets:
  hdl:
    files:
      - hdl/qtt_cmd.sv
    file_type: systemVerilogSource
    depend:
      - qick:cdc:cdc_reg_sync
      - qick:cdc:cdc_handshake
      - qick:cdc:sync_pulse
  tb:
    files:
      - tests/qtt_cmd_tc00.sv
      - tests/qtt_cmd_tests.sv: {is_include_file: true}
    file_type: systemVerilogSource
    depend:
      - qick:common:sim_base
      - qick:processors:qtt_cmd_hold
  lint_files:
    depend:
      - qick:common:lint

generate:
  testrunner_gen:
    generator: svunit_gen
    parameters:
        test_files:
          - tests/qtt_cmd_tc00.sv

targets:
  default: &default
    filesets: [hdl]
    toplevel: qtt_cmd
  lint:
    <<: *default
    filesets_append: [lint_files]
    default_tool: veriblelint
    toplevel: qtt_cmd
    tools:
      verilator:
        mode: lint-only
        verilator_options: [-Wall]
  test:
    <<: *default
    description: Simulate the design
    filesets_append: [tb]
    default_tool: xsim
    generate: [testrunner_gen]
    toplevel: testrunner
    tools:
      xsim:
        xelab_options: [-timescale=1ns/1ps -debug all -L XPM]
        xsim_options: [-testplusarg SVUNIT_FILTER="*" -onerror stop]
