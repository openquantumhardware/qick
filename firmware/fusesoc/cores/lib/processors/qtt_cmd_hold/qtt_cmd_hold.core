CAPI=2:
name: qick:processors:qtt_cmd_hold:1.0.0
description: qtt_cmd_hold (processors library core).

filesets:
  hdl:
    files:
      - hdl/qtt_cmd_hold.sv
    file_type: systemVerilogSource
  tb:
    files:
      - tests/qtt_cmd_hold_tc00.sv
      - tests/qtt_cmd_hold_tests.sv: {is_include_file: true}
    file_type: systemVerilogSource
    depend:
      - qick:common:sim_base
  lint_files:
    depend:
      - qick:common:lint

generate:
  testrunner_gen:
    generator: svunit_gen
    parameters:
        test_files:
          - tests/qtt_cmd_hold_tc00.sv

targets:
  default: &default
    filesets: [hdl]
    toplevel: qtt_cmd_hold
  lint:
    <<: *default
    filesets_append: [lint_files]
    default_tool: veriblelint
    toplevel: qtt_cmd_hold
    tools:
      verilator:
        mode: lint-only
        verilator_options: [-Wall]
  test:
    <<: *default
    description: Simulate the design
    filesets_append: [tb]
    default_tool: xsim
    generate: [testrunner_gen]
    toplevel: testrunner
    tools:
      xsim:
        xelab_options: [-timescale=1ns/1ns -debug all -L XPM]
        xsim_options: [-testplusarg SVUNIT_FILTER="*" -onerror stop]
