        12: cost_name = "arith";  // ARITH T r1 r2 r3 r4
        13: cost_name = "div";  // DIV r1 r2 #3
        14: cost_name = "flag";  // FLAG set
        15: cost_name = "rwave_load";  // REG_WR r_wave wmem [&1]
