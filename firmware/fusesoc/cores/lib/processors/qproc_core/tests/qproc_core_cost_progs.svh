function automatic string cost_name(input int u);
    case (u)
        0: cost_name = "nop";  // NOP
        1: cost_name = "reg_imm";  // REG_WR r1 imm #5
        2: cost_name = "reg_chain";  // REG_WR r1 op -op(r1 + #1)  (dependent)
