        5: cost_name = "cjump_taken";  // TEST -op(r1 - r1) ; JUMP Lk -if(Z)  (taken)
        6: cost_name = "cjump_not";  // TEST -op(r1 - r1) ; JUMP Lk -if(NZ)  (not taken)
        7: cost_name = "time_inc";  // TIME inc_ref #10
        8: cost_name = "dmem_wr";  // DMEM_WR [&0] imm #5
        9: cost_name = "dmem_rd";  // REG_WR r1 dmem [&0]
        10: cost_name = "dmem_rd_use";  // REG_WR r1 dmem [&0] ; REG_WR r2 op -op(r1 + #1)  (load-use)
