CAPI=2:
name: qick:axi:bram_to_axis_nt:1.0.0
description: BRAM to AXI-Stream bridge using a SYNC FIFO as pipe

filesets:
  hdl:
    files:
      - hdl/bram_to_axis_nt.sv
    file_type: systemVerilogSource
    depend:
      - qick:interfaces:axi4_stream_if
      - qick:interfaces:bram_if
      - qick:mem:fifo_sync

  tb:
    files:
      - tests/bram_to_axis_nt_tc00.sv
      - tests/bram_to_axis_nt_tests.sv: {is_include_file: true}
    file_type: systemVerilogSource
    depend:
      - qick:common:sim_base

  lint_files:
    depend:
      - qick:common:lint

generate:
  testrunner_gen:
    generator: svunit_gen
    parameters:
        test_files: 
          - tests/bram_to_axis_nt_tc00.sv

targets:
  default: &default
    filesets: [hdl]
    toplevel: bram_to_axis_nt
    parameters:
      - NB

  lint:
    <<: *default
    filesets_append: [lint_files]
    default_tool: veriblelint
    toplevel: bram_to_axis_nt
    tools:
      verilator:
        mode: lint-only
        verilator_options: [-Wall]

  test:
    <<: *default
    description: Simulate the design
    filesets_append: [tb]
    default_tool: xsim
    generate: [testrunner_gen]
    toplevel: testrunner
    tools:
      xsim:
        xelab_options: [-timescale=1ns/1ns -debug all -L XPM -d SVUNIT]
        xsim_options: [-testplusarg SVUNIT_FILTER="*" -onerror stop]
      modelsim:
        vlog_options: [-timescale=1ns/1ns -L xpm]              # XPM library
      icarus:
        iverilog_options:
          - -g2012 # Use SystemVerilog-2012

  synth:
    <<: *default
    description: Synthesize the design
    default_tool: vivado
    filesets_append:
      - pynq_z2
    tools:
      vivado:
        part: xc7z020clg400-1
        synth_options:
          - -include_dirs $XILINX_VIVADO/data/ip/xpm

    parameters:
      - NB=8

parameters:
  NB:
    datatype    : int
    description : Width of the I/O ports in bits
    paramtype   : vlogparam
