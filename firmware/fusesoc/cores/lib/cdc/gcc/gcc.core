CAPI=2:
name: qick:cdc:gcc:1.0.0
description: gcc (cdc library core).

filesets:
  hdl:
    files:
      - hdl/gcc.sv
    file_type: systemVerilogSource
    # depend:
    #   - qick:pkg:<your_pkg>   # add package deps here if needed
  tb:
    files:
      - tests/gcc_tc00.sv
      - tests/gcc_tests.sv: {is_include_file: true}
    file_type: systemVerilogSource
    depend:
      - qick:common:sim_base
  lint_files:
    depend:
      - qick:common:lint

generate:
  testrunner_gen:
    generator: svunit_gen
    parameters:
        test_files:
          - tests/gcc_tc00.sv

targets:
  default: &default
    filesets: [hdl]
    toplevel: gcc
  lint:
    <<: *default
    filesets_append: [lint_files]
    default_tool: veriblelint
    toplevel: gcc
    tools:
      verilator:
        mode: lint-only
        verilator_options: [-Wall]
  test:
    <<: *default
    description: Simulate the design
    filesets_append: [tb]
    default_tool: xsim
    generate: [testrunner_gen]
    toplevel: testrunner
    tools:
      xsim:
        xelab_options: [-timescale=1ns/1ns -debug all -L XPM]
        xsim_options: [-testplusarg SVUNIT_FILTER="*" -onerror stop]
