CAPI=2:
name: qick:dsp:sg_mixmux8:1.0.0
description: sg_mixmux8 (dsp library core).

filesets:
  hdl:
    files:
      - hdl/sg_mixmux8.sv
    file_type: systemVerilogSource
    depend:
      - qick:mem:fifo_sync
      - qick:dsp:dds_top_mixmux8
      - qick:ctrl:ctrl_sgmux8
      - qick:utils:delay_line
  tb:
    files:
      - tests/sg_mixmux8_tc00.sv
      - tests/sg_mixmux8_tests.sv: {is_include_file: true}
    file_type: systemVerilogSource
    depend:
      - qick:common:sim_base
      - qick:common:xilinx
  lint_files:
    depend:
      - qick:common:lint

generate:
  testrunner_gen:
    generator: svunit_gen
    parameters:
        test_files:
          - tests/sg_mixmux8_tc00.sv

targets:
  default: &default
    filesets: [hdl]
    toplevel: sg_mixmux8
  lint:
    <<: *default
    filesets_append: [lint_files]
    default_tool: veriblelint
    toplevel: sg_mixmux8
    tools:
      verilator:
        mode: lint-only
        verilator_options: [-Wall]
  test:
    <<: *default
    description: Simulate the design
    filesets_append: [tb]
    default_tool: xsim
    generate: [testrunner_gen]
    toplevel: testrunner
    tools:
      xsim:
        xelab_options: [-debug all -L XPM -top work.glbl -timescale=1ns/1ps]
        xsim_options: [-testplusarg SVUNIT_FILTER="*" -onerror stop]
