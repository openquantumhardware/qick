CAPI=2:
name: qick:dsp:phase_shifter:1.0.0
description: phase_shifter (dsp library core).

filesets:
  hdl:
    files:
      - hdl/phase_shifter.sv
    file_type: systemVerilogSource
  #mem:
  #  files:
  #    - hdl/sine_table.mem
  #    - hdl/cosine_table.mem
  #  file_type: user
  tb:
    files:
      - tests/phase_shifter_tc00.sv: {file_type: systemVerilogSource}
      - tests/phase_shifter_tests.sv: {is_include_file: true}
    #  - hdl/sine_table.mem: {file_type: user, copyto: sine_table.mem}
    #  - hdl/cosine_table.mem: {file_type: user, copyto: cosine_table.mem}
    depend:
      - qick:common:sim_base
  lint_files:
    depend:
      - qick:common:lint

generate:
  testrunner_gen:
    generator: svunit_gen
    parameters:
        test_files:
          - tests/phase_shifter_tc00.sv

targets:
  default: &default
    #filesets: [hdl, mem]
    filesets: [hdl]
    toplevel: phase_shifter
  lint:
    <<: *default
    filesets_append: [lint_files]
    default_tool: veriblelint
    toplevel: phase_shifter
    tools:
      verilator:
        mode: lint-only
        verilator_options: [-Wall]
  test:
    <<: *default
    description: Simulate the design
    filesets_append: [tb]
    default_tool: xsim
    generate: [testrunner_gen]
    toplevel: testrunner
    tools:
      xsim:
        xelab_options: [-timescale=1ns/1ns -debug all -L XPM]
        xsim_options: [-testplusarg SVUNIT_FILTER="*" -onerror stop]
