CAPI=2:
name: qick:dsp:dds_phasegen_sincos_ow16_lat8:1.0.0
description: >
  DDS Compiler, "phasegen_sincos_ow16_lat8" variant (Xilinx IP, Component_Name 
  renamed from dds_0). Used by axis_kidsim_v3. Behavioural model for sim/lint 
  via dds_compiler_model; real .xci for synth/packaging.
filesets:
  # Behavioural model for simulation and lint (RTL-pure, no Xilinx IP).
  sim_model:
    files:
      - hdl/dds_phasegen_sincos_ow16_lat8.sv
    file_type: systemVerilogSource
    depend:
      - qick:dsp:dds_compiler_model

  # Real Xilinx IP for synthesis/packaging.
  synth_xci:
    files:
      - xci/dds_phasegen_sincos_ow16_lat8.xci: {file_type: xci}
  
  lint_files:
    depend:
      - qick:common:lint

targets:
  default: &default
    filesets: [sim_model]

  lint:
    <<: *default
    filesets_append: [lint_files]
    default_tool: veriblelint
    toplevel: dds_phasegen_sincos_ow16_lat8
    tools:
      verilator:
        mode: lint-only
        verilator_options: [-Wall]

  sim:
    filesets: [sim_model]

  synth:
    filesets: [synth_xci]
