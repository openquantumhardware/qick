CAPI=2:
name: qick:dsp:qtt_tag_calc:1.0.1
description: qtt_tag_calc (dsp library core).

filesets:
  hdl:
    files:
      - hdl/qtt_tag_calc.sv
    file_type: systemVerilogSource
    depend:
      - qick:encoders:priority_encoder
      - qick:dsp:x_inter
  tb:
    files:
      - tests/qtt_tag_calc_tc00.sv
      - tests/qtt_tag_calc_tests.sv: {is_include_file: true}
    file_type: systemVerilogSource
    depend:
      - qick:common:sim_base
  lint_files:
    depend:
      - qick:common:lint

generate:
  testrunner_gen:
    generator: svunit_gen
    parameters:
        test_files:
          - tests/qtt_tag_calc_tc00.sv

targets:
  default: &default
    filesets: [hdl]
    toplevel: qtt_tag_calc
  lint:
    <<: *default
    filesets_append: [lint_files]
    default_tool: veriblelint
    toplevel: qtt_tag_calc
    tools:
      verilator:
        mode: lint-only
        verilator_options: [-Wall]
  test:
    <<: *default
    description: Simulate the design
    filesets_append: [tb]
    default_tool: xsim
    generate: [testrunner_gen]
    toplevel: testrunner
    tools:
      xsim:
        xelab_options: [-timescale=1ns/1ns -debug all -L XPM]
        xsim_options: [-testplusarg SVUNIT_FILTER="*" -onerror stop]
