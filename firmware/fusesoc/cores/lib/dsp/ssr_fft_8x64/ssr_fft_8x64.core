CAPI=2:
name: qick:dsp:ssr_fft_8x64:1.0.1
description: >
  64-point complex FFT, 8 samples per clock (SSR), generated by Xilinx System
  Generator (entity ssr_8x64). Vendor-generated VHDL (source: openquantumhardware/qick
  firmware/ip/axis_pfb_readout_v3|v4/src/pfb/fft/ssr_fft_8x64, identical in
  both), used by the PFB readouts. One change: the generated package's own
  BOOLEAN_VECTOR type is renamed BOOL_VECTOR, because under VHDL-2008 (what
  Vivado 2025.2 synthesizes the IP's VHDL as) it collides with
  std.standard.boolean_vector. Compiles as VHDL-93 and -2008.

filesets:
  hdl:
    files:
      - hdl/conv_pkg.vhd
      - hdl/synth_reg.vhd
      - hdl/synth_reg_w_init.vhd
      - hdl/synth_reg_reg.vhd
      - hdl/single_reg_w_init.vhd
      - hdl/srl33e.vhd
      - hdl/xlclockdriver_rd.vhd
      - hdl/ssr_8x64_entity_declarations.vhd
      - hdl/ssr_8x64.vhd
    file_type: vhdlSource
    logical_name: xil_defaultlib

  tb:
    files:
      - tests/ssr_fft_8x64_tc00.sv
      - tests/ssr_fft_8x64_tests.sv: {is_include_file: true}
    file_type: systemVerilogSource
    depend:
      - qick:common:sim_base

targets:
  default: &default
    filesets: [hdl]
    toplevel: ssr_8x64

  test:
    description: Sanity-check the vendor FFT (tones land in one bin)
    filesets: [hdl, tb]
    default_tool: xsim
    generate: [testrunner_gen]
    toplevel: testrunner
    tools:
      xsim:
        xelab_options: [-timescale=1ns/1ps -L xil_defaultlib]
        xsim_options: [-testplusarg SVUNIT_FILTER="*" -onerror stop]

generate:
  testrunner_gen:
    generator: svunit_gen
    parameters:
        test_files:
          - tests/ssr_fft_8x64_tc00.sv
