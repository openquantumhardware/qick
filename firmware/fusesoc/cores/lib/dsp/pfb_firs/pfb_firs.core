CAPI=2:
name: qick:dsp:pfb_firs:1.0.0
description: >
  PFB readouts' polyphase filter stage: eight FIRs (fir_pfb_ro_0..7) over the
  input lanes and their one-vector-delayed copies, with pfb_ctrl. Port of the
  legacy firs.sv (axis_pfb_readout_v3/v4).

filesets:
  hdl:
    files:
      - hdl/pfb_firs.sv
    file_type: systemVerilogSource
    depend:
      - qick:dsp:pfb_ctrl
      - qick:utils:zn_nb
      - qick:dsp:fir_pfb_ro_0
      - qick:dsp:fir_pfb_ro_1
      - qick:dsp:fir_pfb_ro_2
      - qick:dsp:fir_pfb_ro_3
      - qick:dsp:fir_pfb_ro_4
      - qick:dsp:fir_pfb_ro_5
      - qick:dsp:fir_pfb_ro_6
      - qick:dsp:fir_pfb_ro_7

  tb_ref_vhd:
    files:
      - tests/ref/zn_nb_legacy.vhd
    file_type: vhdlSource

  tb:
    files:
      - tests/ref/firs_legacy.sv
      - tests/pfb_firs_tc00.sv
      - tests/pfb_firs_tests.sv: {is_include_file: true}
    file_type: systemVerilogSource
    depend:
      - qick:common:sim_base

  lint_files:
    depend:
      - qick:common:lint

targets:
  default: &default
    filesets: [hdl]
    toplevel: pfb_firs

  lint:
    filesets: [hdl, lint_files]
    toplevel: pfb_firs
    default_tool: veriblelint
    tools:
      verilator:
        mode: lint-only
        verilator_options: [-Wall]

  test:
    description: Simulate the design (against the legacy RTL as the golden model)
    filesets: [hdl, tb_ref_vhd, tb]
    default_tool: xsim
    generate: [testrunner_gen]
    toplevel: testrunner
    tools:
      xsim:
        xelab_options: [-debug all -timescale=1ns/1ps]
        xsim_options: [-testplusarg SVUNIT_FILTER="*" -onerror stop]

generate:
  testrunner_gen:
    generator: svunit_gen
    parameters:
        test_files:
          - tests/pfb_firs_tc00.sv
