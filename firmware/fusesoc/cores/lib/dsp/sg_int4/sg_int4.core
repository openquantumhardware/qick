CAPI=2:
name: qick:dsp:sg_int4:1.0.0
description: sg_int4 (dsp library core).

filesets:
  hdl:
    files:
      - hdl/sg_int4.sv
    file_type: systemVerilogSource
    depend:
      - qick:ctrl:ctrl_sgv4
      - qick:dsp:fir_interp4_sgint
      - qick:dsp:dds_compiler_dyn_readout
      - qick:utils:delay_line
  tb:
    files:
      - tests/sg_int4_tc00.sv
      - tests/sg_int4_tests.sv: {is_include_file: true}
    file_type: systemVerilogSource
    depend:
      - qick:common:sim_base
  lint_files:
    depend:
      - qick:common:lint

generate:
  testrunner_gen:
    generator: svunit_gen
    parameters:
        test_files:
          - tests/sg_int4_tc00.sv

targets:
  default: &default
    filesets: [hdl]
    toplevel: sg_int4
  lint:
    <<: *default
    filesets_append: [lint_files]
    default_tool: veriblelint
    toplevel: sg_int4
    tools:
      verilator:
        mode: lint-only
        verilator_options: [-Wall]
  test:
    <<: *default
    description: Simulate the design
    filesets_append: [tb]
    default_tool: xsim
    generate: [testrunner_gen]
    toplevel: testrunner
    tools:
      xsim:
        xelab_options: [-timescale=1ns/1ns -debug all -L XPM]
        xsim_options: [-testplusarg SVUNIT_FILTER="*" -onerror stop]
