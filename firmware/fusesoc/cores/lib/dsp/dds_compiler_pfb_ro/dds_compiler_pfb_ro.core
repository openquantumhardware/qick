CAPI=2:
name: qick:dsp:dds_compiler_pfb_ro:1.0.0
description: >
  DDS Compiler, "pfb_ro" variant (Xilinx IP, Component_Name renamed from the
  legacy dds_0 of axis_pfb_readout_v3/v4). Used by the PFB readouts' DDS
  stage. Behavioural model for sim/lint via dds_compiler_model; real .xci for
  synth/packaging. tests/vendor/run_vendor_check.sh compares the model with
  the real core (needs Vivado).
filesets:
  # Behavioural model for simulation and lint (RTL-pure, no Xilinx IP).
  sim_model:
    files:
      - hdl/dds_compiler_pfb_ro.sv
    file_type: systemVerilogSource
    depend:
      - qick:dsp:dds_compiler_model

  # Real Xilinx IP for synthesis/packaging.
  synth_xci:
    files:
      - xci/dds_compiler_pfb_ro.xci: {file_type: xci}

  lint_files:
    depend:
      - qick:common:lint

targets:
  default: &default
    filesets: [sim_model]

  lint:
    <<: *default
    filesets_append: [lint_files]
    default_tool: veriblelint
    toplevel: dds_compiler_pfb_ro
    tools:
      verilator:
        mode: lint-only
        verilator_options: [-Wall]

  sim:
    filesets: [sim_model]

  synth:
    filesets: [synth_xci]
