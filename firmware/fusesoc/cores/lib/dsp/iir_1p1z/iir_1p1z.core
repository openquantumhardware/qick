CAPI=2:
name: qick:dsp:iir_1p1z:1.0.0
description: iir_1p1z (dsp library core).

filesets:
  hdl:
    files:
      - hdl/iir_1p1z.sv
    file_type: systemVerilogSource
  tb:
    files:
      - tests/iir_1p1z_tc00.sv
      - tests/iir_1p1z_tests.sv: {is_include_file: true}
    file_type: systemVerilogSource
    depend:
      - qick:common:sim_base
  lint_files:
    depend:
      - qick:common:lint

generate:
  testrunner_gen:
    generator: svunit_gen
    parameters:
        test_files:
          - tests/iir_1p1z_tc00.sv

targets:
  default: &default
    filesets: [hdl]
    toplevel: iir_1p1z
  lint:
    <<: *default
    filesets_append: [lint_files]
    default_tool: veriblelint
    toplevel: iir_1p1z
    tools:
      verilator:
        mode: lint-only
        verilator_options: [-Wall]
  test:
    <<: *default
    description: Simulate the design
    filesets_append: [tb]
    default_tool: xsim
    generate: [testrunner_gen]
    toplevel: testrunner
    tools:
      xsim:
        xelab_options: [-timescale=1ns/1ns -debug all -L XPM]
        xsim_options: [-testplusarg SVUNIT_FILTER="*" -onerror stop]
