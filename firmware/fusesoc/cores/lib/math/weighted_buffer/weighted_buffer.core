CAPI=2:
name: qick:math:weighted_buffer:1.0.0
description: weighted_buffer (math library core).

filesets:
  hdl:
    files:
      - hdl/weighted_buffer.sv
    file_type: systemVerilogSource
    depend:
      - qick:cdc:cdc_bit_sync
      - qick:dsp:matched_filter
      - qick:math:avg_top
      - qick:math:buffer_top
  tb:
    files:
      - tests/weighted_buffer_tc00.sv
      - tests/weighted_buffer_tests.sv: {is_include_file: true}
    file_type: systemVerilogSource
    depend:
      - qick:common:xilinx
      - qick:common:sim_base
      - qick:interfaces:axi4_stream_if
  lint_files:
    depend:
      - qick:common:lint

generate:
  testrunner_gen:
    generator: svunit_gen
    parameters:
        test_files:
          - tests/weighted_buffer_tc00.sv

targets:
  default: &default
    filesets: [hdl]
    toplevel: weighted_buffer
  lint:
    <<: *default
    filesets_append: [lint_files]
    default_tool: veriblelint
    toplevel: weighted_buffer
    tools:
      verilator:
        mode: lint-only
        verilator_options: [-Wall]
  test:
    <<: *default
    description: Simulate the design
    filesets_append: [tb]
    default_tool: xsim
    generate: [testrunner_gen]
    toplevel: testrunner
    tools:
      xsim:
        xelab_options: [-debug all -L XPM -top work.glbl -timescale=1ns/1ps -d SVUNIT]
        xsim_options: [-testplusarg SVUNIT_FILTER="*" -onerror stop]
