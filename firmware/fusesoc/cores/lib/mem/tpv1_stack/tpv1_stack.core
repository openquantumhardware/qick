CAPI=2:
name: qick:mem:tpv1_stack:1.0.0
description: Stack core for the TPROC v1

filesets:
  hdl:
    files:
      - hdl/tpv1_stack.sv
    file_type: systemVerilogSource
    depend:
      - qick:mem:bram_simple_sp

  tb:
    files:
      - tests/tpv1_stack_tc00.sv
      - tests/tpv1_stack_tests.sv: {is_include_file: true}
    file_type: systemVerilogSource
    depend:
      - qick:common:sim_base

  lint_files:
    depend:
      - qick:common:lint

generate:
  testrunner_gen:
    generator: svunit_gen
    parameters:
        test_files: 
          - tests/tpv1_stack_tc00.sv

targets:
  default: &default
    filesets: [hdl]
    toplevel: tpv1_stack
  lint:
    <<: *default
    filesets_append: [lint_files]
    default_tool: veriblelint
    toplevel: tpv1_stack
    tools:
      verilator:
        mode: lint-only
        verilator_options: [-Wall]

  test:
    <<: *default
    description: Simulate the design
    filesets_append: [tb]
    default_tool: xsim
    generate: [testrunner_gen]
    toplevel: testrunner
    tools:
      xsim:
        xelab_options: [-timescale=1ns/1ns -debug all -L XPM]
        xsim_options: [-testplusarg SVUNIT_FILTER="*" -onerror stop]
