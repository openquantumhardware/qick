CAPI=2:
name: qick:mem:fifo_axi:1.0.0
description: >
  Single-clock FIFO with the legacy rd2axi read adapter (valid/ready-style read
  side). Port of the legacy VHDL fifo_axi (fifo + rd2axi) used by
  axis_buffer_ddr, on qick:mem:fifo.

filesets:
  hdl:
    files:
      - hdl/fifo_axi.sv
    file_type: systemVerilogSource
    depend:
      - qick:mem:fifo

  tb_ref:
    files:
      - tests/ref/bram_simple_dp_legacy.vhd
      - tests/ref/fifo_legacy.vhd
      - tests/ref/rd2axi_legacy.vhd
      - tests/ref/fifo_axi_legacy.vhd
    file_type: vhdlSource

  tb:
    files:
      - tests/fifo_axi_tc00.sv
      - tests/fifo_axi_tests.sv: {is_include_file: true}
    file_type: systemVerilogSource
    depend:
      - qick:common:sim_base

  lint_files:
    depend:
      - qick:common:lint

targets:
  default: &default
    filesets: [hdl]
    toplevel: fifo_axi

  lint:
    filesets: [hdl, lint_files]
    toplevel: fifo_axi
    default_tool: veriblelint
    tools:
      verilator:
        mode: lint-only
        verilator_options: [-Wall]

  test:
    description: Simulate the design (against the legacy VHDL as the golden model)
    filesets: [hdl, tb_ref, tb]
    default_tool: xsim
    generate: [testrunner_gen]
    toplevel: testrunner
    tools:
      xsim:
        xelab_options: [-debug all -timescale=1ns/1ps]
        xsim_options: [-testplusarg SVUNIT_FILTER="*" -onerror stop]

generate:
  testrunner_gen:
    generator: svunit_gen
    parameters:
        test_files:
          - tests/fifo_axi_tc00.sv
