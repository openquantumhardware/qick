CAPI=2:
name: qick:mem:qcore_reg_bank:1.0.0
description: qcore_reg_bank (mem library core).

filesets:
  hdl:
    files:
      - hdl/qcore_reg_bank.sv
    file_type: systemVerilogSource
    depend:
      - qick:utils:lfsr
  tb:
    files:
      - tests/qcore_reg_bank_tc00.sv
      - tests/qcore_reg_bank_tests.sv: {is_include_file: true}
    file_type: systemVerilogSource
    depend:
      - qick:common:sim_base
  lint_files:
    depend:
      - qick:common:lint

generate:
  testrunner_gen:
    generator: svunit_gen
    parameters:
        test_files:
          - tests/qcore_reg_bank_tc00.sv

targets:
  default: &default
    filesets: [hdl]
    toplevel: qcore_reg_bank
  lint:
    <<: *default
    filesets_append: [lint_files]
    default_tool: veriblelint
    toplevel: qcore_reg_bank
    tools:
      verilator:
        mode: lint-only
        verilator_options: [-Wall]
  test:
    <<: *default
    description: Simulate the design
    filesets_append: [tb]
    default_tool: xsim
    generate: [testrunner_gen]
    toplevel: testrunner
    tools:
      xsim:
        xelab_options: [-timescale=1ns/1ns -debug all -L XPM]
        xsim_options: [-testplusarg SVUNIT_FILTER="*" -onerror stop]
