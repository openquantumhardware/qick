CAPI=2:
name: qick:mem:bram_simple_sp:1.1.0
description: Single-port block RAM, one clock, write-first, optional $readmemb image

filesets:
  hdl:
    files:
      - hdl/bram_simple_sp.sv
    file_type: systemVerilogSource

  tb:
    files:
      - tests/bram_simple_sp_tc00.sv
      - tests/tests.sv: {is_include_file: true}
      - tests/bram_simple_sp_init.mem: {file_type: user, copyto: bram_simple_sp_init.mem}
    file_type: systemVerilogSource
    depend:
      - qick:common:sim_base

  lint_files:
    depend:
      - qick:common:lint

generate:
  testrunner_gen:
    generator: svunit_gen
    parameters:
      test_files:
        - tests/bram_simple_sp_tc00.sv

targets:
  default: &default
    filesets: [hdl, lint_files]

  lint:
    <<: *default
    default_tool: veriblelint
    toplevel: bram_simple_sp

  test:
    <<: *default
    description: Reference-model testbench (SVUnit)
    filesets_append: [tb]
    default_tool: xsim
    generate: [testrunner_gen]
    toplevel: testrunner
    tools:
      xsim:
        xelab_options: [-debug all -timescale=1ns/1ps]
        xsim_options: [-testplusarg SVUNIT_FILTER="*" -onerror stop]
