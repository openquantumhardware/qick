CAPI=2:
name: qick:ctrl:ctrl_ro_v2:1.0.1
description: ctrl_ro_v2 (ctrl library core).

filesets:
  hdl:
    files:
      - hdl/ctrl_ro_v2.sv
    file_type: systemVerilogSource
    # depend:
    #   - qick:pkg:<your_pkg>   # add package deps here if needed
  tb:
    files:
      - tests/ctrl_ro_v2_tc00.sv
      - tests/ctrl_ro_v2_tests.sv: {is_include_file: true}
    file_type: systemVerilogSource
    depend:
      - qick:common:sim_base
  lint_files:
    depend:
      - qick:common:lint

generate:
  testrunner_gen:
    generator: svunit_gen
    parameters:
        test_files:
          - tests/ctrl_ro_v2_tc00.sv

targets:
  default: &default
    filesets: [hdl]
    toplevel: ctrl_ro_v2
  lint:
    <<: *default
    filesets_append: [lint_files]
    default_tool: veriblelint
    toplevel: ctrl_ro_v2
    tools:
      verilator:
        mode: lint-only
        verilator_options: [-Wall]
  test:
    <<: *default
    description: Simulate the design
    filesets_append: [tb]
    default_tool: xsim
    generate: [testrunner_gen]
    toplevel: testrunner
    tools:
      xsim:
        xelab_options: [-timescale=1ns/1ns -debug all -L XPM]
        xsim_options: [-testplusarg SVUNIT_FILTER="*" -onerror stop]
