CAPI=2:
name: qick:ctrl:punct:1.0.0
description: "Puncturing / per-frame sample selector: asserts enable on the sample at index ID_REG."
filesets:
  hdl:
    files:
      - hdl/punct.sv
    file_type: systemVerilogSource
  tb:
    files:
      - tests/punct_tc00.sv
      - tests/punct_tests.sv: {is_include_file: true}
    file_type: systemVerilogSource
    depend:
      - qick:common:sim_base
  lint_files:
    depend:
      - qick:common:lint
generate:
  testrunner_gen:
    generator: svunit_gen
    parameters:
        test_files:
          - tests/punct_tc00.sv
targets:
  default: &default
    filesets: [hdl]
    toplevel: punct
  lint:
    <<: *default
    filesets_append: [lint_files]
    default_tool: veriblelint
    toplevel: punct
    tools:
      verilator:
        mode: lint-only
        verilator_options: [-Wall]
  test:
    <<: *default
    description: Simulate the design
    filesets_append: [tb]
    default_tool: xsim
    generate: [testrunner_gen]
    toplevel: testrunner
    tools:
      xsim:
        xelab_options: [-timescale=1ns/1ns -debug all -L XPM]
        xsim_options: [-testplusarg SVUNIT_FILTER="*" -onerror stop]