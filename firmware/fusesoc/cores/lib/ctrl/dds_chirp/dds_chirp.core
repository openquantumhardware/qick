CAPI=2:
name: qick:ctrl:dds_chirp:1.0.0
description: "DDS with linear frequency modulation (chirp): dds_phase_ctrl + DDS IP (streaming pinc)."
filesets:
  hdl:
    files:
      - hdl/dds_chirp.sv
    file_type: systemVerilogSource
    depend:
      - qick:ctrl:dds_phase_ctrl
      - qick:dsp:dds_phasegen_sincos_ow16_lat8   # model for sim, .xci for synth
  tb:
    files:
      - tests/dds_chirp_tc00.sv
      - tests/dds_chirp_tests.sv: {is_include_file: true}
    file_type: systemVerilogSource
    depend:
      - qick:common:sim_base
  lint_files:
    depend:
      - qick:common:lint
generate:
  testrunner_gen:
    generator: svunit_gen
    parameters:
        test_files:
          - tests/dds_chirp_tc00.sv
targets:
  default: &default
    filesets: [hdl]
    toplevel: dds_chirp
  lint:
    <<: *default
    filesets_append: [lint_files]
    default_tool: veriblelint
    toplevel: dds_chirp
    tools:
      verilator:
        mode: lint-only
        verilator_options: [-Wall]
  test:
    <<: *default
    description: Simulate the design
    filesets_append: [tb]
    default_tool: xsim
    generate: [testrunner_gen]
    toplevel: testrunner
    tools:
      xsim:
        xelab_options: [-timescale=1ns/1ns -debug all -L XPM]
        xsim_options: [-testplusarg SVUNIT_FILTER="*" -onerror stop]