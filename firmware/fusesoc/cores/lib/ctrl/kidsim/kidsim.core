CAPI=2:
name: qick:ctrl:kidsim:1.0.0
description: "KID simulator datapath: demod (cmult) -> IIR resonator -> remod (cmult), with chirped DDS."
filesets:
  hdl:
    files:
      - hdl/kidsim.sv
    file_type: systemVerilogSource
    depend:
      - qick:ctrl:dds_chirp
      - qick:dsp:cmult
      - qick:dsp:iir_iq
      - qick:utils:delay_line
  tb:
    files:
      - tests/kidsim_tc00.sv
      - tests/kidsim_tests.sv: {is_include_file: true}
    file_type: systemVerilogSource
    depend:
      - qick:common:sim_base
  lint_files:
    depend:
      - qick:common:lint
generate:
  testrunner_gen:
    generator: svunit_gen
    parameters:
        test_files:
          - tests/kidsim_tc00.sv
targets:
  default: &default
    filesets: [hdl]
    toplevel: kidsim
  lint:
    <<: *default
    filesets_append: [lint_files]
    default_tool: veriblelint
    toplevel: kidsim
    tools:
      verilator:
        mode: lint-only
        verilator_options: [-Wall]
  test:
    <<: *default
    description: Simulate the design
    filesets_append: [tb]
    default_tool: xsim
    generate: [testrunner_gen]
    toplevel: testrunner
    tools:
      xsim:
        xelab_options: [-timescale=1ns/1ns -debug all -L XPM]
        xsim_options: [-testplusarg SVUNIT_FILTER="*" -onerror stop]