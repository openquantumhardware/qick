CAPI=2:
name: qick:utils:qproc_dispatcher:1.0.1
description: qproc_dispatcher (utils library core).

filesets:
  hdl:
    files:
      - hdl/qproc_dispatcher.sv
    file_type: systemVerilogSource
    depend:
      - qick:pkg:tpv2_pkg
      - qick:mem:fifo_async
      - qick:cdc:cdc_reg_sync
  tb:
    files:
      - tests/qproc_dispatcher_tc00.sv
      - tests/qproc_dispatcher_tests.sv: {is_include_file: true}
    file_type: systemVerilogSource
    depend:
      - qick:common:xilinx
      - qick:common:sim_base
  lint_files:
    depend:
      - qick:common:lint

generate:
  testrunner_gen:
    generator: svunit_gen
    parameters:
        test_files:
          - tests/qproc_dispatcher_tc00.sv

targets:
  default: &default
    filesets: [hdl]
    toplevel: qproc_dispatcher
  lint:
    <<: *default
    filesets_append: [lint_files]
    default_tool: veriblelint
    toplevel: qproc_dispatcher
    tools:
      verilator:
        mode: lint-only
        verilator_options: [-Wall]
  test:
    <<: *default
    description: Simulate the design
    filesets_append: [tb]
    default_tool: xsim
    generate: [testrunner_gen]
    toplevel: testrunner
    tools:
      xsim:
        xelab_options: [-debug all -L XPM -top work.glbl -timescale=1ns/1ps]
        xsim_options: [-testplusarg SVUNIT_FILTER="*" -onerror stop]
