CAPI=2:
name: qick:utils:wide_en_signal:0.1.0
description: Enable pulse generator for a wide enable signal.

filesets:
  hdl:
    files:
      - hdl/wide_en_signal.sv
    file_type: systemVerilogSource
    depend: 
      - qick:cdc:cdc_bit_sync
      - qick:utils:rising_edge_det

  tb:
    files:
      - tests/wide_en_signal_tc00.sv
      - tests/tests.sv: {is_include_file: true}
    file_type: systemVerilogSource
    depend: 
      - qick:common:sim_base

  lint_files:
    depend:
      - qick:common:lint

  pynq_z2:
    files:
      - data/pynq_z2.xdc: {file_type: xdc}

generate:
  testrunner_gen:
    generator: svunit_gen
    parameters:
        test_files: 
          - tests/wide_en_signal_tc00.sv

targets:
  default: &default
    filesets:
      - hdl
      - lint_files
    toplevel: wide_en_signal
    parameters:
      - NB

  lint:
    <<: *default
    default_tool: veriblelint
    toplevel: wide_en_signal
    tools:
      verilator:
        mode: lint-only
        verilator_options: [-Wall]

  test:
    <<: *default
    description: Simulate the design
    filesets_append: [tb]
    default_tool: xsim
    generate: [testrunner_gen]
    toplevel: testrunner
    tools:
      xsim:
        xelab_options: [-debug all -L XPM]
        xsim_options: [-testplusarg SVUNIT_FILTER="*" -onerror stop]
      icarus:
        iverilog_options:
          - -g2012 # Use SystemVerilog-2012
      modelsim:
        vlog_options:
          - -timescale=1ns/1ns

  # The "synth" target synthesizes the design. (It could have any name.)
  synth:
    <<: *default
    description: Synthesize the design for a Nexys Video FPGA board
    default_tool: vivado
    filesets_append:
      - pynq_z2
    tools:
      vivado:
        part: xc7z020clg400-1
    parameters:
      - NB=8

parameters:
  NB:
    datatype    : int
    description : Width of the I/O ports in bits
    paramtype   : vlogparam
