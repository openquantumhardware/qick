CAPI=2:
name: qick:utils:tx_cmd:0.1.0
description: Board communication peripheral.

filesets:
  hdl:
    files:
      - hdl/tx_cmd.sv
    file_type: systemVerilogSource
    depend:
       - qick:utils:xcom_link_tx


  tb:
    files:
      - data/states.txt: {file_type : user, copyto : states.txt}
      - tests/tx_cmd_tc00.sv
      - tests/tests.sv: {is_include_file: true}
    file_type: systemVerilogSource
    depend: 
      - qick:common:sim_base
      - qick:common:xilinx

  lint_files:
    depend:
      - qick:common:lint

generate:
  testrunner_gen:
    generator: svunit_gen
    parameters:
        test_files: 
          - tests/tx_cmd_tc00.sv

targets:
  default: &default
    filesets:
      - hdl
      - lint_files
    toplevel: tx_cmd
    parameters:
      - NB

  lint:
    <<: *default
    default_tool: veriblelint
    toplevel: [bram]
    tools:
      verilator:
        mode: lint-only
        verilator_options: [-Wall]

  test:
    <<: *default
    description: Simulate the design
    filesets_append: [tb]
    default_tool: xsim
    generate: [testrunner_gen]
    toplevel: [testrunner, glbl]
    tools:
      xsim:
        xelab_options: [-timescale=1ns/1ns -debug all -L XPM -L unisims_ver -L secureip]
        xsim_options: [-testplusarg SVUNIT_FILTER="*" -onerror stop]
      icarus:
        iverilog_options:
          - -g2012 # Use SystemVerilog-2012
      modelsim:
        vlog_options:
          - -timescale=1ns/1ns

  # The "synth" target synthesizes the design. (It could have any name.)
  synth:
    <<: *default
    description: Synthesize the design for a Nexys Video FPGA board
    default_tool: vivado
    filesets_append:
      - pynq_z2
    tools:
      vivado:
        part: xc7z020clg400-1
    parameters:
      - NB=8

parameters:
  NB:
    datatype    : int
    description : Width of the I/O ports in bits
    paramtype   : vlogparam
