CAPI=2:
name: qick:utils:rx_cmd:0.1.0
description: Board communication peripheral. Wrapper and synchronization logic for the xcom_link_rx block. 

filesets:
  hdl:
    files:
      - hdl/rx_cmd.sv
    file_type: systemVerilogSource
    depend:
       - qick:utils:xcom_link_rx
       - qick:pkg:qick_pkg


  tb:
    files:
      - data/states.txt: {file_type : user, copyto : states.txt}
      - data/opcodes.txt: {file_type : user, copyto : opcodes.txt}
      - tests/rx_cmd_tc00.sv
      - tests/tests.sv: {is_include_file: true}
    file_type: systemVerilogSource
    depend: 
      - qick:common:sim_base
      # provides glbl.v, needed by the ODELAYE3/ODDRE1 UNISIM primitives
      # that xcom_link_tx instantiates (cf. xcom_link_tx.core)
      - qick:common:xilinx
      - qick:utils:xcom_link_tx

  lint_files:
    depend:
      - qick:common:lint

  pynq_z2:
    files:
      - data/pynq_z2.xdc: {file_type: xdc}

generate:
  testrunner_gen:
    generator: svunit_gen
    parameters:
        test_files: 
          - tests/rx_cmd_tc00.sv

targets:
  default: &default
    filesets:
      - hdl
      - lint_files
    toplevel: rx_cmd
    parameters:
      - NB

  lint:
    <<: *default
    default_tool: veriblelint
    toplevel: rx_cmd
    tools:
      verilator:
        mode: lint-only
        verilator_options: [-Wall]

  test:
    <<: *default
    description: Simulate the design
    filesets_append: [tb]
    default_tool: xsim
    generate: [testrunner_gen]
    # glbl is required alongside testrunner: rx_cmd pulls in xcom_link_tx,
    # which instantiates ODELAYE3/ODDRE1, and those UNISIM primitives need
    # glbl's global reset net. Same shape as xcom_link_tx.core.
    toplevel: [testrunner, glbl]
    tools:
      xsim:
        xelab_options: [-timescale=1ns/1ns -debug all -L XPM -L unisims_ver -L secureip]
        xsim_options: [-testplusarg SVUNIT_FILTER="*" -onerror stop]
      icarus:
        iverilog_options:
          - -g2012 # Use SystemVerilog-2012
      modelsim:
        vlog_options:
          - -timescale=1ns/1ns

  # The "synth" target synthesizes the design. (It could have any name.)
  synth:
    <<: *default
    description: Synthesize the design 
    default_tool: vivado
    filesets_append:
      - pynq_z2
    tools:
      vivado:
        part: xc7z020clg400-1
    parameters:
      - NB=8

parameters:
  NB:
    datatype    : int
    description : Width of the I/O ports in bits
    paramtype   : vlogparam
