# Package the qick:ip IPs of a project's block design before Hog creates the project.
#
# Sourced by Top/<group>/<project>/pre-creation.tcl, which sets qick_top_dir to its
# own directory first (and qick_bd_dir, if the BD scripts live in another project's
# directory). Hog runs pre-creation.tcl before it creates the project.
#
# firmware/ip/ is generated by fusesoc and ignored by git. Without this step a build
# uses whatever package is on disk, possibly older than the sources of the commit
# being built, and the bitstream could not be rebuilt from its SHA. Here every
# qick:ip IP the project declares (qick_ips.txt) is packaged again from the
# sources of the current commit, so "check out the SHA, Hog/Do CREATE, Hog/Do W"
# rebuilds the same design -- provided the SHA follows those sources, which is what
# the hog-lists check below makes sure of.

set qick_fw_dir [file normalize "$qick_top_dir/../../.."]
if {![info exists qick_bd_dir]} { set qick_bd_dir $qick_top_dir }

# The IPs to package are DECLARED, one place per project: Top/<group>/<project>/qick_ips.txt,
# one qick:ip name per line, '#' starts a comment. (They used to be found by reading the
# BD script, which depends on how that script is written; the BD is only checked against
# the declaration, by gen_qick_ip_lists.py below.)
set qick_decl "$qick_top_dir/qick_ips.txt"
if {![file exists $qick_decl]} {
    error "pre-creation: $qick_decl missing -- declare the qick:ip IPs the project uses, one per line\
           (python3 scripts/hog/gen_qick_ip_lists.py --init Top/<group>/<project> writes it from the BD)"
}
set fh [open $qick_decl r]
set qick_ips {}
foreach line [split [read $fh] "\n"] {
    set line [string trim [lindex [split $line "#"] 0]]
    if {$line ne ""} { lappend qick_ips $line }
}
close $fh
set qick_ips [lsort -unique $qick_ips]

# Vivado exports PYTHONHOME/PYTHONPATH/LD_LIBRARY_PATH pointing at its own
# Python (3.8 in 2023.1). Inherited by `make package`, they break the venv's
# python3 (`No module named '_sha512'`, `OPENSSL_3.4.0 not found`). Drop them
# for the make only: the vivado that ip_packager.py starts sets them again.
set qick_clean_env {}
foreach v {PYTHONHOME PYTHONPATH LD_LIBRARY_PATH} { lappend qick_clean_env -u $v }

# Hog names the build (version, SHA) after the newest commit among the files in the
# project's list files. The RTL packaged below is listed in list/qick_ip_rtl.src and
# list/qick_ip_xdc.con (scripts/hog/gen_qick_ip_lists.py); refuse to build while they
# do not match the sources about to be packaged, or the build would carry a SHA that
# does not reproduce it. Checked first: it takes a second, packaging takes minutes.
set qick_proj_rel [string range [file normalize $qick_top_dir] [string length "$qick_fw_dir/Top/"] end]
set qick_lists_args [list hog-lists PROJ=$qick_proj_rel CHECK=1]
if {[file normalize $qick_bd_dir] ne [file normalize $qick_top_dir]} {
    lappend qick_lists_args BD_DIR=[file normalize $qick_bd_dir]
}
puts "pre-creation: make hog-lists PROJ=$qick_proj_rel CHECK=1"
if {[catch {exec env {*}$qick_clean_env make -s -C "$qick_fw_dir/fusesoc" {*}$qick_lists_args >@ stdout 2>@ stderr} err]} {
    error "pre-creation: list/qick_ip_rtl.src or list/qick_ip_xdc.con of $qick_proj_rel is stale (see above): $err"
}

foreach ip $qick_ips {
    puts "pre-creation: make package IP=$ip"
    if {[catch {exec env {*}$qick_clean_env make -C "$qick_fw_dir/fusesoc" package IP=$ip >@ stdout 2>@ stderr} err]} {
        error "pre-creation: packaging $ip failed: $err"
    }
    if {![file exists "$qick_fw_dir/ip/$ip/component.xml"]} {
        error "pre-creation: $qick_fw_dir/ip/$ip/component.xml missing after packaging"
    }
}
puts "pre-creation: packaged [llength $qick_ips] qick:ip IPs declared in qick_ips.txt: [join $qick_ips { }]"
